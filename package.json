{
  "name": "system-hunter-ascension",
  "version": "2.0.0",
  "description": "System Hunter: Ascension - Enhanced RPG Clicker Game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "System Hunter Dev",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.systemhunter.ascension",
    "productName": "System Hunter: Ascension",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "game.js",
      "main.js"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons"
    }
  }
}
